# OSINT ENGINE
# ═══════════════════════════════════════════════════════════════════════
BASE_SITES = {
    "Reddit": {"url": "https://www.reddit.com/user/{u}/about.json", "api": "https://www.reddit.com/user/{u}/about.json"},
    "Telegram": {"url": "https://t.me/{u}", "hit": ["tgme_page_title"]},
    "Mastodon": {"url": "https://mastodon.social/@{u}"},
    "Bluesky": {"url": "https://bsky.app/profile/{u}.bsky.social"},
    "Instagram": {"url": "https://www.instagram.com/{u}/"},
    "TikTok": {"url": "https://www.tiktok.com/@{u}"},
    "GitHub": {"url": "https://github.com/{u}", "api": "https://api.github.com/users/{u}"},
    "GitLab": {"url": "https://gitlab.com/{u}"},
    "HackerNews": {"url": "https://news.ycombinator.com/user?id={u}", "miss": ["no such user."]},
    "Steam": {"url": "https://steamcommunity.com/id/{u}", "miss": ["the specified profile could not be found"]},
    "YouTube": {"url": "https://www.youtube.com/@{u}"},
}

def generate_variants(name: str) -> list[str]:
    base = name.strip()
    low = base.lower()
    out = [base]
    seen = {base}
    def add(v):
        if v and v not in seen and USERNAME_RE.match(v):
            seen.add(v); out.append(v)
    leet = low.replace("a", "4").replace("e", "3").replace("i", "1").replace("o", "0")
    add(leet)
    for suffix in ("1", "01", "99", "0", "7", "_"):
        add(f"{low}{suffix}")
    return out[:10]

async def check_site(session, name, spec, username):
    url = spec["url"].format(u=username)
    try:
        async with session.get(url, timeout=8) as r:
            if r.status in (404, 410): return None
            if not (200 <= r.status < 300): return None
            text = (await r.content.read(128*1024)).decode("utf-8", "ignore").lower()

            if spec.get("miss") and any(m in text for m in spec["miss"]): return None
            if spec.get("hit") and not any(h in text for h in spec["hit"]): return None

            enrich = ""
            img = None
            if "api" in spec:
                try:
                    async with session.get(spec["api"].format(u=username), timeout=5) as ar:
                        if ar.status == 200:
                            data = await ar.json()
                            if name == "GitHub":
                                enrich = f"({data.get('name','')} | {data.get('followers',0)} foll)"
                                img = data.get("avatar_url")
                            elif name == "Reddit":
                                d = data.get("data", {})
                                enrich = f"({d.get('total_karma',0)} karma)"
                                icon = d.get("icon_img") or ""
                                img = icon.split("?")[0] if icon else None
                except Exception:
                    pass
            return {"site": name, "url": url, "username": username, "enrich": enrich, "img": img}
    except Exception:
        return None

async def run_username_scan(target: str) -> list[dict]:
    variants = generate_variants(target)
    sites = {**BASE_SITES, **get_custom_sites()}
    headers = {"User-Agent": UA}
    sem = asyncio.Semaphore(30)
    async def worker(session, v, n, s):
        async with sem:
            return await check_site(session, n, s, v)
    async with aiohttp.ClientSession(headers=headers) as session:
        tasks = [worker(session, v, n, s) for v in variants for n, s in sites.items()]
        results = await asyncio.gather(*tasks)
        return [r for r in results if r]

